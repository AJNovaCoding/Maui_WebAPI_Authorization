<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiLoginAuth.DataEntry"
             Title="DataEntry">
    <VerticalStackLayout
        Padding="30"
        Spacing="15">
        
        <Label 
            Text="Arnetta Jones - Data Entry Page"
            FontSize="24"
            FontAttributes="Bold"/>
        <Label 
            Text="Please provide the following information:"
            FontSize="18"/>
        
        <Entry
            x:Name="txtItemId"
            Placeholder="Item ID"/>
        <Entry
            x:Name="txtItemName"
            Placeholder="Item Name"/>
        <Entry
            x:Name="txtItemDescription"
            Placeholder="Item Description"/>
        <Button
            Text="Save"
            Clicked="OnSaveClicked"/>
        <Button
            Text="Cancel"
            Clicked="OnCancelClicked"/>
        <Label
            Text="Stored Items"/>

    </VerticalStackLayout>
</ContentPage>